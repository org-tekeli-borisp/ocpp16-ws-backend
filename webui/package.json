{
  "name": "ocpp16-webui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/post-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:start": "docker compose -f ../docker-compose.e2e.yml up -d --wait",
    "test:e2e:stop": "docker compose -f ../docker-compose.e2e.yml down --remove-orphans",
    "test:e2e:docker": "docker run --rm --network host ${E2E_BASE_URL:+--env E2E_BASE_URL=$E2E_BASE_URL} -v ${PWD}/..:/repo -w /repo/webui mcr.microsoft.com/playwright:v1.62.1-jammy npx playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
