# Docker Compose Configuration
# Copy to .env and customize for your environment

# --- Application ---
# Leave empty to build locally, or set to pull from GHCR:
# APP_IMAGE=ghcr.io/org-tekeli-borisp/ocpp16-ws-backend:latest
# APP_IMAGE=ghcr.io/org-tekeli-borisp/ocpp16-ws-backend:latest-native
APP_IMAGE=

# Dockerfile for local builds (JVM or Native):
DOCKERFILE=src/main/docker/Dockerfile.jvm

# Ports
APP_PORT=8080
APP_SSL_PORT=8443
POSTGRES_PORT=5432

# --- PostgreSQL ---
POSTGRES_DB=ocpp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production

# --- TLS / WSS Configuration ---
# Enable HTTPS/WSS (set to true to enable)
QUARKUS_HTTP_SSL_ENABLED=false
# Server certificate path (mounted from CERTS_DIR)
QUARKUS_HTTP_SSL_CERTIFICATE_FILE=/certs/server.crt
QUARKUS_HTTP_SSL_CERTIFICATE_KEY_FILE=/certs/server.key
# Client certificate mode: NONE, REQUEST, REQUIRED, REJECT
QUARKUS_HTTP_SSL_CLIENT_CERT=REQUEST
# Directory containing TLS certificates (mounted as /certs in container)
CERTS_DIR=./certs

# --- Monitoring (docker-compose.monitoring.yml) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production
