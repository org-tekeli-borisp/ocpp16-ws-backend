<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.tekeli.borisp</groupId>
    <artifactId>ocpp16-ws-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>quarkus</packaging>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <kotlin.version>2.3.21</kotlin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.36.2</quarkus.platform.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <pitest.version>1.23.0</pitest.version>
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
        <crap.threshold>8</crap.threshold>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets-next</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets-next-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk8</artifactId>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>kotlin-extensions</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.mockk</groupId>
            <artifactId>mockk</artifactId>
            <version>1.13.10</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <javaParameters>true</javaParameters>
                    <jvmTarget>25</jvmTarget>
                    <compilerPlugins>
                        <plugin>all-open</plugin>
                    </compilerPlugins>
                    <pluginOptions>
                        <option>all-open:annotation=jakarta.ws.rs.Path</option>
                        <option>all-open:annotation=jakarta.enterprise.context.ApplicationScoped</option>
                        <option>all-open:annotation=jakarta.persistence.Entity</option>
                        <option>all-open:annotation=io.quarkus.test.junit.QuarkusTest</option>
                    </pluginOptions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco</outputDirectory>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
 
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>org.tekeli.borisp.ocpp16.protocol.OcppMessage</param>
                        <param>org.tekeli.borisp.ocpp16.protocol.OcppMessage$Call</param>
                        <param>org.tekeli.borisp.ocpp16.protocol.OcppMessage$CallResult</param>
                        <param>org.tekeli.borisp.ocpp16.protocol.OcppMessage$CallError</param>
                        <param>org.tekeli.borisp.ocpp16.protocol.OcppMessage$Companion</param>
                        <param>org.tekeli.borisp.ocpp16.protocol.ResponseAwaiter</param>
                        <param>org.tekeli.borisp.ocpp16.websocket.OcppWebSocketServer</param>
                        <param>org.tekeli.borisp.ocpp16.websocket.ChargePointRegistry</param>
                        <param>org.tekeli.borisp.ocpp16.handler.BootNotificationHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.HeartbeatHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.AuthorizeHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.StartTransactionHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.StopTransactionHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.StatusNotificationHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.MeterValuesHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.DataTransferHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.FirmwareStatusNotificationHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.DiagnosticsStatusNotificationHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.SecurityEventNotificationHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.SignedFirmwareStatusNotificationHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.LogStatusNotificationHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.SignCertificateHandler</param>
                        <param>org.tekeli.borisp.ocpp16.handler.CertificateSignedHandler</param>
                        <param>org.tekeli.borisp.ocpp16.outbound.OutboundCallDispatcher</param>
                        <param>org.tekeli.borisp.ocpp16.command.RemoteStartTransactionCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.RemoteStopTransactionCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.ResetCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.UnlockConnectorCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.CancelReservationCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.ChangeAvailabilityCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.ChangeConfigurationCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.ClearCacheCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.ClearChargingProfileCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.GetCompositeScheduleCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.GetConfigurationCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.GetDiagnosticsCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.GetLocalListVersionCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.ReserveNowCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.SendLocalListCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.SetChargingProfileCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.TriggerMessageCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.UpdateFirmwareCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.ExtendedTriggerMessageCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.InstallCertificateCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.GetInstalledCertificateIdsCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.DeleteCertificateCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.GetLogCommand</param>
                        <param>org.tekeli.borisp.ocpp16.command.SignedUpdateFirmwareCommand</param>
                    </targetClasses>
                    <targetTests>
                         <param>org.tekeli.borisp.ocpp16.OcppMessageTest</param>
                         <param>org.tekeli.borisp.ocpp16.OcppWebSocketServerUnitTest</param>
                         <param>org.tekeli.borisp.ocpp16.ResponseAwaiterTest</param>
                         <param>org.tekeli.borisp.ocpp16.OutboundCallDispatcherTest</param>
                         <param>org.tekeli.borisp.ocpp16.ChargePointRegistryTest</param>
                         <param>org.tekeli.borisp.ocpp16.command.OcppCommandTest</param>
                         <param>org.tekeli.borisp.ocpp16.command.SecurityCommandTest</param>
                         <param>org.tekeli.borisp.ocpp16.command.GetLogCommandMutationTest</param>
                         <param>org.tekeli.borisp.ocpp16.command.SignedUpdateFirmwareCommandMutationTest</param>
                         <param>org.tekeli.borisp.ocpp16.handler.SecurityEventNotificationHandlerTest</param>
                         <param>org.tekeli.borisp.ocpp16.handler.SignedFirmwareStatusNotificationHandlerTest</param>
                         <param>org.tekeli.borisp.ocpp16.handler.LogStatusNotificationHandlerTest</param>
                         <param>org.tekeli.borisp.ocpp16.handler.SignCertificateHandlerTest</param>
                         <param>org.tekeli.borisp.ocpp16.handler.CertificateSignedHandlerTest</param>
                         <param>org.tekeli.borisp.ocpp16.handler.HandlerMutationTest</param>
                         <param>org.tekeli.borisp.ocpp16.handler.StopTransactionHandlerDirectTest</param>
                         <param>org.tekeli.borisp.ocpp16.handler.StartTransactionHandlerDirectTest</param>
                         <param>org.tekeli.borisp.ocpp16.handler.StartTransactionHandlerHandleTest</param>
                         <param>org.tekeli.borisp.ocpp16.handler.BootNotificationHandlerDirectTest</param>
                         <param>org.tekeli.borisp.ocpp16.mutation.MutationKillTest</param>
                         <param>org.tekeli.borisp.ocpp16.mutation.MutationKillTest2</param>
                     </targetTests>
                    <excludedMethods>
                        <exclude>parseJsonNode</exclude>
                    </excludedMethods>
                     <mutators>
                        <mutator>CONDITIONALS_BOUNDARY</mutator>
                        <mutator>EMPTY_RETURNS</mutator>
                        <mutator>FALSE_RETURNS</mutator>
                        <mutator>INCREMENTS</mutator>
                        <mutator>INVERT_NEGS</mutator>
                        <mutator>MATH</mutator>
                        <mutator>NEGATE_CONDITIONALS</mutator>
                        <mutator>NON_VOID_METHOD_CALLS</mutator>
                        <mutator>PRIMITIVE_RETURNS</mutator>
                        <mutator>REMOVE_CONDITIONALS_EQUAL_ELSE</mutator>
                        <mutator>REMOVE_CONDITIONALS_EQUAL_IF</mutator>
                        <mutator>REMOVE_CONDITIONALS_ORDER_ELSE</mutator>
                        <mutator>REMOVE_CONDITIONALS_ORDER_IF</mutator>
                        <mutator>REMOVE_INCREMENTS</mutator>
                        <mutator>TRUE_RETURNS</mutator>
                    </mutators>

                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <verbose>false</verbose>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
        <profile>
            <id>crap</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-plugin</artifactId>
                        <version>${kotlin.version}</version>
                        <executions>
                            <execution>
                                <id>compile-crap-metrics</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <sourceDirs>
                                        <sourceDir>${project.basedir}/src/main/tools</sourceDir>
                                    </sourceDirs>
                                    <output>${project.build.directory}/crap-metrics-classes</output>
                                    <jvmTarget>25</jvmTarget>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>crap-metrics</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>org.tekeli.borisp.ocpp16.tools.CrapMetricsAnalyzer</mainClass>
                                    <includeProjectDependencies>true</includeProjectDependencies>
                                    <additionalClasspathElements>
                                        <additionalClasspathElement>${project.build.directory}/crap-metrics-classes</additionalClasspathElement>
                                    </additionalClasspathElements>
                                    <arguments>
                                        <argument>${project.reporting.outputDirectory}/jacoco/jacoco.xml</argument>
                                        <argument>${crap.threshold}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
